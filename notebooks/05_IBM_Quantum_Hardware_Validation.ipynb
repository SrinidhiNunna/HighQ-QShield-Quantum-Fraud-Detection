   "source": [
    "from qiskit.circuit.library import zz_feature_map\n",
    "\n",
    "feature_map = zz_feature_map(\n",
    "    feature_dimension=4,\n",
    "    reps=2\n",
    ")\n",
    "\n",
    "# Add measurements\n",
    "feature_map.measure_all()\n",
    "\n",
    "# Draw circuit\n",
    "feature_map.draw(\"mpl\")"
   ]
  },
